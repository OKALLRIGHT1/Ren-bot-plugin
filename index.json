{
    "schema": 1,
    "name": "Ren-bot plugins",
    "source": "https://github.com/OKALLRIGHT1/Ren-bot-plugin",
    "note": "Source catalog only. Per-plugin release zips and sha256 are not published yet.",
    "plugins": [
        {
            "id": "agently_mail",
            "name": "Agent Mail",
            "trigger": "agently_mail",
            "version": "0.2.0",
            "type": "direct",
            "summary": "通过本机 agently-cli 查询、读取、搜索和按确认流程发送邮件；支持新邮件 QQ 私聊通知。",
            "path": "agently_mail"
        },
        {
            "id": "backup_manager",
            "name": "备份恢复",
            "trigger": "backup_manager",
            "version": "0.0.0",
            "type": "react",
            "summary": "管理关键文件快照。参数格式：action ||| arg；action可用 create/list/restore。restore 需确认；仅本地或管理员私聊。",
            "path": "backup_manager"
        },
        {
            "id": "code_agent",
            "name": "代码代理",
            "trigger": "code_agent",
            "version": "0.0.0",
            "type": "direct",
            "summary": "把代码项目分析或修改任务委托给本机 Codex CLI / Claude Code。修改模式必须确认。",
            "path": "code_agent"
        },
        {
            "id": "desktop_hub",
            "name": "桌面",
            "trigger": "desktop_hub",
            "version": "1.0.0",
            "type": "react",
            "summary": "打开信任列表里的本地软件，并查看或调整 CPU/内存/音量/亮度/锁屏。",
            "path": "desktop_hub"
        },
        {
            "id": "diary_export",
            "name": "日记管家",
            "trigger": "diary_manager",
            "version": "1.1.0",
            "type": "react",
            "summary": "管理每日总结日记。功能：1.查询特定日期的日记(如:昨天干了什么)；2.导出所有日记为Markdown文件(如:导出日记)。",
            "path": "diary_export"
        },
        {
            "id": "dice_plugin",
            "name": "骰子",
            "trigger": "dice_roll",
            "version": "1.0.0",
            "type": "direct",
            "summary": "掷骰指令（D&D/CoC/选项表）",
            "path": "dice_plugin"
        },
        {
            "id": "egg_search",
            "name": "洛克王国世界查蛋器",
            "trigger": "egg_search",
            "version": "1.0.0",
            "type": "direct",
            "summary": "输入尺寸和重量，返回匹配的精灵种类。",
            "path": "egg_search"
        },
        {
            "id": "Isuzu_news",
            "name": "日报",
            "trigger": "magic_daily",
            "version": "1.1.0",
            "type": "direct",
            "summary": "图片版日报，并查询实时/未来几天天气。ALAPI Token 填在设置→信息源或本插件配置里。",
            "path": "Isuzu_news"
        },
        {
            "id": "life_hub",
            "name": "生活提醒",
            "trigger": "life_hub",
            "version": "1.0.0",
            "type": "react",
            "summary": "记账、本地提醒、待办、番茄钟，以及 QQ 周期打卡提醒。",
            "path": "life_hub"
        },
        {
            "id": "local_knowledge",
            "name": "本地第二大脑",
            "trigger": "knowledge_base",
            "version": "1.1.0",
            "type": "react",
            "summary": "用于管理本地知识库。支持指令：learn (扫描文件夹并学习), search (搜索知识库)。参数：指令 ||| 内容(文件夹路径或查询词)",
            "path": "local_knowledge"
        },
        {
            "id": "meme_pack",
            "name": "表情包库",
            "trigger": "meme_pack",
            "version": "0.1.0",
            "type": "direct",
            "summary": "数据库版表情包系统：支持目录导入、按情绪/关键词选图、QQ 手动发送，并提供自动发送钩子。",
            "path": "meme_pack"
        },
        {
            "id": "moegirl_wiki",
            "name": "萌娘百科查询",
            "trigger": "moegirl_wiki",
            "version": "0.0.0",
            "type": "delegate",
            "summary": "查询萌娘百科词条、角色、作品、术语，并返回主词条与相关语境。",
            "path": "moegirl_wiki"
        },
        {
            "id": "music_player",
            "name": "音乐播放器",
            "trigger": "播放音乐",
            "version": "1.2.0",
            "type": "react",
            "summary": "播放本地音乐。明确歌名填歌名；要推荐填「推荐」；随便听填「随机」。只评价歌曲时不要调用。",
            "path": "music_player"
        },
        {
            "id": "owner_channel_bridge",
            "name": "主人跨通道近史",
            "trigger": "owner_channel_bridge",
            "version": "1.0.0",
            "type": "delegate",
            "summary": "主人按需查询桌面或 QQ 另一侧的近史摘要。默认会话仍隔离，不会自动混进 prompt。参数：desktop|qq|other ||| 可选关键词",
            "path": "owner_channel_bridge"
        },
        {
            "id": "owner_console",
            "name": "主人控制台",
            "trigger": "owner_console",
            "version": "1.0.0",
            "type": "react",
            "summary": "/帮助、/重启（仅主人）、Agent 自检、副脑任务、模型调用摘要。",
            "path": "owner_console"
        },
        {
            "id": "qq_draw",
            "name": "QQ生图",
            "trigger": "qq生图",
            "version": "1.5.0",
            "type": "direct",
            "summary": "仅在 QQ 中用固定斜杠命令触发生图。模型唯一来自「模型与路由」：先给模型勾选画图用途，再在任务路由「画图」里手动选择要用的模型与顺序（不会自动全选）。",
            "path": "qq_draw"
        },
        {
            "id": "qq_file_browser",
            "name": "QQ文件浏览",
            "trigger": "qq文件",
            "version": "1.0.0",
            "type": "direct",
            "summary": "在 QQ 中安全浏览 /bot 虚拟目录并发送文件（零拷贝）。",
            "path": "qq_file_browser"
        },
        {
            "id": "qq_music",
            "name": "QQ点歌",
            "trigger": "qq_music",
            "version": "1.1.0",
            "type": "direct",
            "summary": "通过多平台音乐网关搜索歌曲，默认先搜 QQ 音乐，搜不到再回退网易云，并直接以 QQ 语音形式回发。",
            "path": "qq_music"
        },
        {
            "id": "qq_role_switch",
            "name": "QQ角色切换",
            "trigger": "qq角色",
            "version": "1.0.0",
            "type": "direct",
            "summary": "在 QQ 中查看角色列表，并用斜杠命令快速切换角色。也支持直接用 `/角色名` 切换。",
            "path": "qq_role_switch"
        },
        {
            "id": "qq_watermark",
            "name": "QQ去水印",
            "trigger": "qq_watermark",
            "version": "1.0.0",
            "type": "direct",
            "summary": "QQ 中用 /去水印、/提取 或 /下载 加链接，解析公开平台视频或图集，下载后发回当前会话。明确的自然语言请求会先确认；只有链接不会触发。密钥只存在本机加密存储里。",
            "path": "qq_watermark"
        },
        {
            "id": "vision",
            "name": "屏幕",
            "trigger": "vision",
            "version": "1.1.0",
            "type": "observe",
            "summary": "看屏幕/摄像头并分析；QQ 里说「截图发我」会把当前屏幕发回给主人。",
            "path": "vision"
        },
        {
            "id": "what_to_eat",
            "name": "今天吃什么",
            "trigger": "what_to_eat",
            "version": "0.0.0",
            "type": "direct",
            "summary": "仅响应斜杠命令，支持附图推荐、查做法，以及 /吃什么十连 这类拼图抽卡。",
            "path": "what_to_eat"
        },
        {
            "id": "xinsanguo_voice",
            "name": "新三国语音",
            "trigger": "xinsanguo_voice",
            "version": "0.0.0",
            "type": "direct",
            "summary": "识别新三国经典台词关键词并回发对应音频文件。",
            "path": "xinsanguo_voice"
        }
    ]
}
