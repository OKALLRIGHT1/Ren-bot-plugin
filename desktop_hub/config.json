{
    "name": "桌面",
    "trigger": "desktop_hub",
    "llm_command": "desktop_hub",
    "llm_commands": [
        "open_app",
        "check",
        "monitor"
    ],
    "aliases": [
        "硬件",
        "监控",
        "状态",
        "cpu",
        "memory",
        "内存",
        "温度",
        "temperature",
        "sys",
        "check",
        "检查",
        "音量",
        "亮度",
        "静音",
        "锁屏"
    ],
    "direct_command_aliases": [
        "/打开",
        "打开",
        "启动"
    ],
    "type": "react",
    "description": "包含：打开本机软件、CPU/内存、音量/亮度、锁屏。",
    "example_arg": "计算器",
    "timeout_sec": 10,
    "access_control": {
        "allow_local": true,
        "allow_remote_qq": true,
        "allow_qq_owner": true,
        "allow_qq_others": false,
        "allow_group_without_at": false
    },
    "settings": {
        "app_list": {
            "type": "list",
            "item_type": "app_list",
            "label": "应用信任列表",
            "description": "仅列表内应用可在本地或管理员私聊下免确认启动。格式：显示名|路径",
            "default": [
                "计算器|calc.exe",
                "记事本|notepad.exe",
                "画图|mspaint.exe",
                "任务管理器|taskmgr.exe"
            ]
        },
        "cpu_threshold": {
            "type": "number",
            "label": "CPU使用率阈值 (%)",
            "description": "当CPU使用率超过此值时发出警告",
            "default": 80,
            "min": 1,
            "max": 100
        },
        "memory_threshold": {
            "type": "number",
            "label": "内存使用率阈值 (%)",
            "description": "当内存使用率超过此值时发出警告",
            "default": 85,
            "min": 1,
            "max": 100
        },
        "disk_threshold": {
            "type": "number",
            "label": "磁盘使用率阈值 (%)",
            "description": "当磁盘使用率超过此值时发出警告",
            "default": 90,
            "min": 1,
            "max": 100
        },
        "cpu_temp_threshold": {
            "type": "number",
            "label": "CPU温度阈值 (℃)",
            "description": "当CPU温度超过此值时发出警告",
            "default": 75,
            "min": 1,
            "max": 120
        },
        "gpu_threshold": {
            "type": "number",
            "label": "GPU使用率阈值 (%)",
            "description": "当GPU使用率超过此值时发出警告",
            "default": 85,
            "min": 1,
            "max": 100
        },
        "gpu_temp_threshold": {
            "type": "number",
            "label": "GPU温度阈值 (℃)",
            "description": "当GPU温度超过此值时发出警告",
            "default": 80,
            "min": 1,
            "max": 120
        },
        "check_interval": {
            "type": "number",
            "label": "检查间隔 (秒)",
            "description": "后台监控的检查间隔时间",
            "default": 60,
            "min": 10,
            "max": 600
        }
    }
}
